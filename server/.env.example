# Пример .env для docker compose: скопируйте в .env рядом с docker-compose.yml
# и оставьте права только владельцу (chmod 600 .env). Сам .env в git не идёт.

# Ключ шифрования секретов: им шифруются ключи моделей, пароли ящиков,
# токены и ключи SSH. Сгенерировать: openssl rand -base64 32
# Храните его отдельно от копий базы: копия без ключа не расшифровывается,
# а ключ рядом с копией делает шифрование бессмысленным.
SEMA_KEY=

# Необязательно: часовой пояс, если не устраивает пояс из браузера.
# TZ=Europe/Berlin

# Необязательно: модели на хозяине (LM Studio, Ollama) из контейнера —
# «127.0.0.1» в их адресах подменяется этим именем в момент обращения.
# SEMA_HOST_ALIAS=host.docker.internal
